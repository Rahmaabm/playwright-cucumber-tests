<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="LoadTest - Test de Charge Progressive" enabled="true">
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="TARGET_THREADS_PHASE1" elementType="Argument">
            <stringProp name="Argument.name">TARGET_THREADS_PHASE1</stringProp>
            <stringProp name="Argument.value">10</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TARGET_THREADS_PHASE2" elementType="Argument">
            <stringProp name="Argument.name">TARGET_THREADS_PHASE2</stringProp>
            <stringProp name="Argument.value">50</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="TARGET_THREADS_PHASE3" elementType="Argument">
            <stringProp name="Argument.name">TARGET_THREADS_PHASE3</stringProp>
            <stringProp name="Argument.value">100</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.comment" elementType="Comment" guiclass="CommentPanel" testclass="Comment" testname="Comment" enabled="true">
        <stringProp name="Comment.text">
Test de charge progressive en 3 phases:
Phase 1: 10 utilisateurs pendant 60 secondes
Phase 2: 50 utilisateurs pendant 120 secondes
Phase 3: 100 utilisateurs pendant 180 secondes
        </stringProp>
      </elementProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
    </TestPlan>
    <hashTree>
